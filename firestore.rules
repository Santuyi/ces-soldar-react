rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validItem(items, i) {
      return i >= items.size() || (
        items[i].keys().hasOnly(['id', 'name', 'quantity', 'price']) &&
        items[i].id is string &&
        items[i].quantity is int && items[i].quantity > 0 &&
        items[i].price is number && items[i].price >= 0 &&
        items[i].name == get(/databases/$(database)/documents/products/$(items[i].id)).data.name &&
        items[i].price == get(/databases/$(database)/documents/products/$(items[i].id)).data.price &&
        items[i].quantity <= get(/databases/$(database)/documents/products/$(items[i].id)).data.stock
      );
    }
    function subtotal(items, i) { return i < items.size() ? items[i].price * items[i].quantity : 0; }
    function itemId(items, i) { return i < items.size() ? items[i].id : ''; }
    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /orders/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/orders/$(id)) || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId','email','buyer','items','total','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.buyer.keys().hasOnly(['name','phone','address'])
        && request.resource.data.buyer.name is string
        && request.resource.data.buyer.name.size() > 0 && request.resource.data.buyer.name.size() <= 100
        && request.resource.data.buyer.phone is string
        && request.resource.data.buyer.phone.size() >= 6 && request.resource.data.buyer.phone.size() <= 30
        && request.resource.data.buyer.address is string
        && request.resource.data.buyer.address.size() > 0 && request.resource.data.buyer.address.size() <= 250
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 5
        && validItem(request.resource.data.items,0) && validItem(request.resource.data.items,1)
        && validItem(request.resource.data.items,2) && validItem(request.resource.data.items,3) && validItem(request.resource.data.items,4)
        && [itemId(request.resource.data.items,0),itemId(request.resource.data.items,1),itemId(request.resource.data.items,2),itemId(request.resource.data.items,3),itemId(request.resource.data.items,4)].toSet().size() == request.resource.data.items.size() + (request.resource.data.items.size() < 5 ? 1 : 0)
        && request.resource.data.total == subtotal(request.resource.data.items,0) + subtotal(request.resource.data.items,1) + subtotal(request.resource.data.items,2) + subtotal(request.resource.data.items,3) + subtotal(request.resource.data.items,4);
      allow update, delete: if false;
    }
  }
}
